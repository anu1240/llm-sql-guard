# Copy this file, rename the copy to exactly  .env  (no .txt at the end), then fill it in.

LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# Only change this if you get a "model not found" error. The error message
# will list the model names your key can use.
GEMINI_MODEL=gemini-2.5-flash

# Same login you use in MySQL Workbench
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=PASTE_YOUR_WORKBENCH_PASSWORD_HERE
DB_NAME=llm_sql_guard
